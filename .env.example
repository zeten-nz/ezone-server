# ============================================================
# EZONE WARRANTY MANAGEMENT SYSTEM — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains secrets.
#
#   cp .env.example .env
#   nano .env
# ============================================================

# ── Server ───────────────────────────────────────────────────
# The port Node.js listens on. Nginx proxies to this port.
PORT=5000

# 'production' enables: Helmet stricter mode, suppressed stack traces in
# responses, morgan combined format, and other production-only behaviours.
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=ezone_user
DB_PASSWORD=CHANGE_ME_use_a_strong_password
DB_NAME=ezone
DB_PORT=3306

# Number of MySQL connections kept open simultaneously.
# Rule of thumb: (CPU cores × 2) + 1  — tune after load testing.
DB_POOL_SIZE=10

# ── JWT Authentication ────────────────────────────────────────
# Generate a cryptographically secure secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# This value signs every JWT token — if it changes, all existing tokens are invalidated.
JWT_SECRET=CHANGE_ME_generate_with_crypto_randomBytes_64

# Token expiry. Examples: 7d, 24h, 60m
JWT_EXPIRE=7d

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# Include BOTH your frontend domain and any local dev origins.
# No trailing slash. No wildcard (*) in production.
#
# Examples:
#   ALLOWED_ORIGINS=https://ezone.yourdomain.com
#   ALLOWED_ORIGINS=https://ezone.yourdomain.com,http://localhost:5173
ALLOWED_ORIGINS=https://yourdomain.com

# ── Seeding ──────────────────────────────────────────────────
# Set to 'false' in production to skip mock data on startup.
# Only set to 'true' in a fresh development environment.
LOAD_MOCK_DATA=false

# ── EasyGas Integration ──────────────────────────────────────
# EasyGas's HMAC-signed API. The warranty POST uses this URL directly, and
# the integration GET endpoints (brands/products/cars/branches/verify used
# by the catalog sync and the admin connection check) are sub-paths of it —
# see services/easyGasCatalogClient.js. The app runs fine with both of
# these unset (catalog sync just no-ops as a network-error retry) — no need
# to block on this before go-live.
EASYGAS_WARRANTY_API_BASE_URL=https://admin.stag.uz/api/integrations/warranty
# Shared secret EasyGas sends over a secure channel at go-live — never
# commit a real value, never log it. Store server-side only.
EASYGAS_SHARED_SECRET=CHANGE_ME_from_easygas_at_golive

# How often the brands/products/cars catalog sync runs, in milliseconds.
# Catalogs change far less often than warranties needed pushing, so this
# defaults slower. 300000 = 5 min.
EASYGAS_CATALOG_SYNC_INTERVAL_MS=300000
